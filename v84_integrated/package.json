{
  "name": "lunch-decision-v8-4-integrated",
  "version": "8.5.1",
  "private": true,
  "main": "server.js",
  "scripts": {
    "backup": "node scripts/backup.js",
    "setup": "node scripts/setup.js",
    "seed:demo": "npm run seed:base && node scripts/seed-integration.js",
    "migrate:plan": "node scripts/migrate.js --plan",
    "migrate:apply": "node scripts/migrate.js --apply",
    "verify": "node scripts/verify.js",
    "test:ui": "node --test tests/*.test.js",
    "start": "node server.js",
    "check": "node --check server.js && node --check routes/api.js && node --check scripts/migrate.js && node --check scripts/backup.js",
    "seed:base": "node scripts/seed-demo.js",
    "test:api": "node scripts/test-api.js",
    "doctor": "node scripts/doctor.js",
    "news:setup": "node scripts/news-setup.js",
    "news:run": "python -m uvicorn news_service.app:app --host 127.0.0.1 --port 8001",
    "news:test": "python -m pytest -q news_service/tests",
    "news:test:real": "python news_service/tests/real_integration.py --run-live"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "mysql2": "^3.14.4"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
